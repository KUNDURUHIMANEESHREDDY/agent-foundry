# Normalize line endings in the repository to LF.
#
# Without this, a Windows checkout rewrites every file to CRLF, so the same
# commit shows as a whole-file diff on the other OS. The CI matrix runs on both
# ubuntu and windows, and the sabotage job shells out to bash, so stable endings
# are load-bearing rather than cosmetic.
* text=auto eol=lf

*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Generated by the audit and by git itself.
*.db      binary
*.db-journal binary
*.db-wal  binary
*.db-shm  binary
*.pyc     binary