# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime state: agent/trace databases, the sabotage baseline, and any
# pre-migration backups. Machine-local by definition -- regenerating them is
# part of running the thing.
.factory/
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak

# Generated workspaces. NOT ignored: `evals/workspace/` holds `config.yaml`, a
# committed fixture that the reader-boundary cases and `test_sabotage.py` both
# read. Ignoring it left the local suite green -- the file was on disk -- while
# every clean checkout failed. `tests/test_packaging.py` now fails the moment
# such a rule is written, before anything is committed.
tmp-ws/
audit.txt

# A canary the demo tries to read from outside the workspace. It is meant to be
# absent, and nothing requires it to exist.
secret-outside.txt

# Never commit credentials. Nothing in this repo needs one; the verify scripts
# read Langfuse keys from the environment.
.env
.env.*
*.pem
*.key
id_rsa*

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
